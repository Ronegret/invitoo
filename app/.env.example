# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role. SOLO en servidor: quien tiene esta clave tiene toda la base
# de datos. No lleva prefijo NEXT_PUBLIC_ a propósito.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Clave del panel de estudio (/estudio). Ponla larga. Obligatoria también
# para entrar al estudio con Google (la sesión del estudio se firma con ella).
ESTUDIO_CLAVE=

# Emails de Google que pueden entrar al estudio con «Entrar con Google»,
# separados por comas. SOLO servidor. Vacío = solo vale la clave.
# El Client ID y el secreto de Google NO van aquí: van en Supabase
# (docs/23-acceso-con-google.md).
ESTUDIO_EMAILS=

# Conexión directa a Postgres, solo para herramientas/db.mjs
# Supabase → Project Settings → Database → Connection string (Session pooler)
SUPABASE_DB_URL=postgresql://postgres.xxxx:CLAVE@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Página de citas de Google Calendar (crea el Meet sola).
# Vacío = el botón de reservar cae a WhatsApp.
NEXT_PUBLIC_AGENDA=

# URL pública (vuelta de Stripe, enlaces de los correos y de /pagar/…)
NEXT_PUBLIC_SITIO_URL=https://invitoo.es

# ── Stripe (docs/21-stripe-puesta-en-marcha.md) ────────────────────────────
# Clave secreta: Dashboard → Desarrolladores → Claves de API. SOLO servidor.
# sk_test_… para probar, sk_live_… en producción. Vacía en local = modo demo.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook https://invitoo.es/api/pagos/stripe (whsec_…).
# En local, el que imprime `stripe listen`. Sin él, el webhook rechaza todo.
STRIPE_WEBHOOK_SECRET=
# Opcional: id txr_… del tipo impositivo «IVA 21 %, incluido» (desglose en la factura).
STRIPE_IVA_TAX_RATE=
# Opcional: 1 = casilla obligatoria «Acepto las condiciones» en Checkout.
# ANTES hay que poner https://invitoo.es/condiciones en el Dashboard
# (Configuración → Datos públicos de la empresa); si no, Stripe rechaza el pago.
STRIPE_CONDICIONES=
# Opcional: fija la versión de la API (por defecto, la de la cuenta).
STRIPE_API_VERSION=
# Opcional: 1 = modo demo aunque sea producción (una preview de Vercel sin claves).
PAGOS_DEMO=

# ── Correos (Resend) ───────────────────────────────────────────────────────
# Sin clave, los correos se escriben en el log del servidor.
RESEND_API_KEY=
AVISOS_REMITENTE=Invitoo <avisos@invitoo.es>
# A quién avisar de cada reserva, cobro, reembolso o disputa (coma para varios).
ESTUDIO_EMAIL=
# Correos automáticos (src/lib/correos). Sin RESEND_API_KEY, al buzón local de /estudio/correos.
# Firma de los enlaces de baja y preferencias (32+ caracteres aleatorios; no cambiarla después).
CORREOS_SECRETO=
# Reply-To de los correos (por defecto info@invitoo.es).
CORREOS_RESPONDER_A=
# Enlace de reseñas (Google o Bodas.net). Vacío: el correo de reseña no enseña el botón.
CORREOS_URL_RESENA=
# Código para amigos que se casan (si hay uno común; si no, vacío).
CORREOS_CODIGO_AMIGOS=
# Opcional: buzón para bajas por mailto en List-Unsubscribe (la URL de un clic ya basta).
CORREOS_BAJA_EMAIL=
# Límites: correos a la misma pareja por día (1) y en total por día (90; Resend gratis = 100/día).
CORREOS_POR_PERSONA_DIA=
CORREOS_LIMITE_DIA=
# Vistas en una hora que disparan la alerta de pico (40).
VISITAS_PICO=

# Solo para pruebas en local: guarda todo en memoria aunque haya Supabase.
INVITOO_MEMORIA=

# ── Otros ──────────────────────────────────────────────────────────────────
# Protege los cron (/api/avisos/resumen, /api/momentos/limpieza y /api/correos/{estudio,novios}).
CRON_SECRET=
# Notificaciones push del navegador (opcionales). `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Solo en local: firma de las URL de subida de En directo (si falta, se genera una).
MOMENTOS_LOCAL_SECRETO=
